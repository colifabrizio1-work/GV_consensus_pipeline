{
  "business_rules": {
    "datest_scope_source": "scarichi_sales_forecast",
    "csv_separator": ",",
    "encoding": "utf-8-sig",
    "fallback_encoding": "latin1",
    "allowed_gv_datests": [
      "026000",
      "026150",
      "026300",
      "027150",
      "027300",
      "028000",
      "028150",
      "028200",
      "028300",
      "032100",
      "032150",
      "032300",
      "033100",
      "033150",
      "033300"
    ],
    "sales_update_latest_weeks": 0,
    "sales_update_replace_scope": "Replace in toto every Fiscal Week present in the update scarico (latest_weeks = 0 means all weeks of the file), then append the new update rows. Limiting the window to the last N weeks leaves holes when two runs are more than N weeks apart.",
    "datest_map": {
      "026000": "GV SPAIN EL",
      "026150": "GV SPAIN RX",
      "026300": "GV SPAIN EB",
      "027150": "GV UK RX",
      "027300": "GV UK EB",
      "028000": "GV UK EL (EL+3P)",
      "028150": "GV NORDICS RX",
      "028200": "GV NORDICS EL",
      "028300": "GV NORDICS EB",
      "032100": "GV DE&AT EL",
      "032150": "GV DE&AT RX",
      "032300": "GV DE&AT EB",
      "033100": "GV FRANCE EL",
      "033150": "GV FRANCE RX",
      "033300": "GV FRANCE EB"
    },
    "forecast_storage_mode": "latest_only_overwrite",
    "consensus_month_window": "13 fiscal months from target YYYYMM -6 to +6, written in columns B:N.",
    "defill_usage": "Exclude rows where Client Datest + UPC Brand match DATEST + BRAND in 01_Brands Defill.xlsx. Defill is not the datest whitelist.",
    "consensus_target_default": "Current fiscal month from official Fiscal Calendar Monthly sheet.",
    "consensus_product_scope": "Exclude Product Type = Accessories and brands listed in official brand_wearables.xlsx. Missing UPC anagrafica matches are reported and kept.",
    "sales_invalid_upc_rule": "Rows with blank/nan/none/nat UPC are dropped before writing parquet."
  },
  "manual_input": {
    "brand_defill": {
      "path": "{gv.manual_input}\\01_Brands Defill.xlsx",
      "sheet": "DEFILL",
      "datest_column": "DATEST",
      "brand_column": "BRAND"
    },
    "consensus_template": {
      "path": "{gv.manual_input}\\02_Consensus_frames_template.xlsx",
      "sheet": "Consensus Frames"
    }
  },
  "scarichi": {
    "sales_historical": {
      "path": "{gv.scarichi}\\GV_Sales_update_Eliot storico.csv",
      "columns": [
        "Client Datest",
        "UPC",
        "Fiscal Year",
        "Fiscal Month",
        "Fiscal Week",
        "Hist Weekly Sales",
        "Hist - Weekly Sales Act MS>0 (Total)"
      ]
    },
    "sales_update": {
      "path": "{gv.scarichi}\\GV_Sales_update_Eliot.csv",
      "columns": [
        "Client Datest",
        "UPC",
        "Fiscal Year",
        "Fiscal Month",
        "Fiscal Week",
        "Hist Weekly Sales",
        "Hist - Weekly Sales Act MS>0 (Total)"
      ]
    },
    "forecast": {
      "path": "{gv.scarichi}\\GV_Forecast_Eliot.csv",
      "columns": [
        "Client Datest",
        "UPC",
        "Fiscal Week",
        "Forecast (no COV)",
        "Forecast (with COV)",
        "Forecast Approved (with COV)"
      ]
    },
    "sales_historical_uk": {
      "path": "{gv.scarichi}\\storici sales\\GV_Sales_update_Eliot storico UK 2023-2026.csv",
      "separator": ",",
      "datests": [
        "027150",
        "027300",
        "028000"
      ],
      "years": [
        2023,
        2024,
        2025,
        2026
      ],
      "usage": "Backfill-only source for the UK split of 2026-09: the three UK datests never appeared in the other scarichi. Consumed by backfill_sales_gv.py, NEVER by update_sales_gv.py --source custom (that one would rewrite each annual parquet with the UK datests only).",
      "columns": [
        "Client Datest",
        "UPC",
        "Fiscal Year",
        "Fiscal Month",
        "Fiscal Week",
        "Hist Weekly Sales",
        "Hist - Weekly Sales Act MS>0 (Total)"
      ]
    },
    "sales_historical_2024_2023": {
      "path": "{gv.scarichi}\\storici sales\\GV_Sales_update_Eliot storico 2024-2023.csv",
      "separator": ";",
      "years": [
        2023,
        2024
      ],
      "columns": [
        "Client Datest",
        "UPC",
        "Fiscal Year",
        "Fiscal Month",
        "Fiscal Week",
        "Hist Weekly Sales",
        "Hist - Weekly Sales Act MS>0 (Total)"
      ]
    }
  },
  "parquet": {
    "sales_annual_pattern": "{gv.parquet_sales}\\GV_Sales_{year}.parquet",
    "forecast": "{gv.parquet_forecast}\\GV_Forecast.parquet"
  },
  "outputs": {
    "consensus_pattern": "{gv.consensus}\\Consensus_Frames_GV_{yyyymm}.xlsx"
  }
}